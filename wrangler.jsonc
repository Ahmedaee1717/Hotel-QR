{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oldpalaceresort",
  "main": "dist/_worker.js",
  "compatibility_date": "2025-12-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "a0237b95-a68c-46c3-a9b8-0d21bd181fac"
    },
    {
      "binding": "GXI_DB",
      "database_name": "gxi-production",
      "database_id": "22601bff-95b2-4490-b673-5ce102b9758c"
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * MON"
    ]
  }
}